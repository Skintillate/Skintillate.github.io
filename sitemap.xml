---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.pages | where_exp: "p", "p.sitemap != false" | where_exp: "p", "p.noindex != true" | sort: "url" %}
{%- for p in pages %}
{%- unless p.url contains ".css" or p.url contains ".txt" or p.url contains ".webmanifest" %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    {%- if p.ref %}
    {%- assign alts = site.pages | where: "ref", p.ref %}
    {%- if alts.size > 1 %}
    {%- for a in alts %}
    <xhtml:link rel="alternate" hreflang="{{ site.data.i18n[a.lang].hreflang }}" href="{{ a.url | absolute_url }}"/>
    {%- endfor %}
    {%- endif %}
    {%- endif %}
  </url>
{%- endunless %}
{%- endfor %}
</urlset>
